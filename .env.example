# ── Quote form (Resend) ──────────────────────────────────────────────
# Get a free API key at https://resend.com (100 emails/day free)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where quote requests are delivered:
QUOTE_EMAIL_TO=owner@example.com
# Sender. Until you verify your own domain in Resend, keep the default:
QUOTE_EMAIL_FROM="Website <onboarding@resend.dev>"

# ── Admin panel (/admin) GitHub OAuth ────────────────────────────────
# Create a GitHub OAuth App: GitHub → Settings → Developer settings →
# OAuth Apps → New OAuth App
#   Homepage URL:              https://your-domain.com
#   Authorization callback URL: https://your-domain.com/api/callback
OAUTH_GITHUB_CLIENT_ID=xxxxxxxx
OAUTH_GITHUB_CLIENT_SECRET=xxxxxxxx

# ── SEO ──────────────────────────────────────────────────────────────
# Google Search Console verification code (optional, from the HTML-tag method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Telegram notifications (optional) ────────────────────────────────
# Create a bot with @BotFather → /newbot → copy the token.
# TELEGRAM_CHAT_ID: your user id (ask @userinfobot) or a group id
# (add the bot to the group, then it's a negative number).
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxx
TELEGRAM_CHAT_ID=123456789
